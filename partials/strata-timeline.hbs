{{!--
    Hyperstrata: トップページの地層タイムライン。

    記事カードを公開日の降順(新しい記事が上=地表)に並べ、assets/js/strata-graph.js が各行の位置を計測して
    背後に SVG を重ねる。SVG には月ごとの地層の帯、左のガターに種(記事)と根(引用線)を描く。
    引用関係は scripts/hyperstrata-sync.mjs が生成する assets/graph.json から data-strata-graph-url で fetch する。
    表示中の行に無い古い記事への引用は、ガターの端でフェードする 1 本の束にまとめ、本数を data-strata-offpage-label
    の文言(% を本数に置き換える)で示す。JavaScript が無効な環境では通常の記事一覧として表示される。

    記事はコンテキストの posts(home.hbs / index.hbs に Ghost が渡す、そのページの @config.posts_per_page 件)を並べる。
    次ページがある場合は末尾に [data-strata-more](次ページへのリンク)を置き、strata-graph.js がこれを目印に
    link[rel=next] の URL を fetch して行を継ぎ足す(無限スクロール)。JavaScript が無効な環境ではリンクで /page/N/ に進む。
--}}
<section class="gh-strata-timeline gh-outer" data-strata-timeline data-strata-graph-url="{{asset "graph.json"}}" data-strata-label="{{t "Citation graph"}}" data-strata-offpage-label="{{t "+% to deeper layers"}}">
    <div class="gh-inner">
        <ol class="gh-strata-timeline-rows" data-strata-rows>
            {{#foreach posts}}
                <li class="gh-strata-timeline-row {{post_class}}" data-strata-row data-slug="{{slug}}" data-month="{{date format="YYYY-MM"}}">
                    <a class="gh-strata-timeline-card" href="{{url}}">
                        <h3 class="gh-strata-timeline-title is-title" data-strata-row-title>{{title}}</h3>
                        {{#if custom_excerpt}}
                            <p class="gh-strata-timeline-excerpt is-body">{{custom_excerpt}}</p>
                        {{else}}
                            {{#if excerpt}}
                                <p class="gh-strata-timeline-excerpt is-body">{{excerpt}}</p>
                            {{/if}}
                        {{/if}}
                        <footer class="gh-strata-timeline-meta">
                            {{#unless access}}
                                {{^has visibility="public"}}
                                    {{> "icons/lock"}}
                                {{/has}}
                            {{/unless}}
                            <time class="gh-strata-timeline-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                        </footer>
                    </a>
                </li>
            {{/foreach}}
        </ol>

        {{#if pagination.next}}
            <div class="gh-strata-timeline-more is-title" data-strata-more>
                <a href="{{page_url "next"}}">{{t "Load more"}} {{> "icons/arrow"}}</a>
            </div>
        {{/if}}
    </div>
</section>
