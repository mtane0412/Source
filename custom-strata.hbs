{{!< default}}
{{!--
    Hyperstrata: 時系列 × 引用関係のグラフビュー(固定ページ用テンプレート)。
    Ghost 管理画面でページの Template に「Strata」を選ぶと使われる。

    サーバー側では公開記事の一覧を <li> に data 属性(slug / 公開日 / 引用先 slug / 種別)付きで描画し、
    assets/js/strata-graph.js がそれを読み取って SVG のアーク図を描く。
    JavaScript が無効な環境では、この一覧がそのまま記事へのリンクとして表示される。

    引用タグ(#ref-<slug>)は scripts/hyperstrata-sync.mjs が自動付与する。内部タグは foreach の既定では
    除外されるため visibility="all" を指定する。get ヘルパーの limit は Ghost 6 で 100 件が上限
    (gscan もそれ以上を警告する)ため、公開記事が 100 件を超えた場合は古い記事がグラフに含まれない。
--}}

{{#post}}

<main class="gh-main">
    <article class="gh-article {{post_class}}">

        {{#match @page.show_title_and_feature_image}}
            <header class="gh-article-header gh-canvas">
                <h1 class="gh-article-title is-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
                {{/if}}
                {{> "feature-image"}}
            </header>
        {{/match}}

        <section class="gh-content gh-canvas is-body">
            {{content}}
        </section>

        <section class="gh-strata gh-canvas" data-strata>
            <ul class="gh-strata-legend" aria-hidden="true">
                <li><span class="gh-strata-legend-line"></span>{{t "Reference"}}</li>
                <li><span class="gh-strata-legend-line is-correction"></span>{{t "Correction"}}</li>
                <li><span class="gh-strata-legend-line is-supplement"></span>{{t "Supplement"}}</li>
                <li><span class="gh-strata-legend-line is-continuation"></span>{{t "Continuation"}}</li>
                <li><span class="gh-strata-legend-line is-reversal"></span>{{t "Reversal"}}</li>
            </ul>
            <ol class="gh-strata-list" data-strata-list>
                {{#get "posts" include="tags" limit="100" order="published_at asc" as |posts|}}
                    {{#foreach posts}}
                        <li
                            data-slug="{{slug}}"
                            data-published="{{date format="YYYY-MM-DD[T]HH:mm:ssZ"}}"
                            data-refs="{{#foreach tags visibility="all"}}{{#match slug "~^" "hash-ref-"}}{{description}},{{/match}}{{/foreach}}"
                            data-kind="{{#has tag="#correction"}}correction{{else}}{{#has tag="#supplement"}}supplement{{else}}{{#has tag="#continuation"}}continuation{{else}}{{#has tag="#reversal"}}reversal{{/has}}{{/has}}{{/has}}{{/has}}"
                        >
                            <a href="{{url}}">{{title}}</a>
                            <time datetime="{{date format="YYYY-MM-DD"}}">{{date}}</time>
                        </li>
                    {{/foreach}}
                {{/get}}
            </ol>
        </section>

    </article>
</main>

{{/post}}
