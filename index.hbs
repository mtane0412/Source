{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- Hyperstrata: 左側固定の引用グラフペイン。テーマ設定(show_strata_pane)で OFF にできる。
     index.hbs はページ送り(/page/N/)でも使われるが、body に home-template が付くトップページだけに表示する --}}
{{#if @custom.show_strata_pane}}
    {{#is "home"}}
        {{> "strata-pane"}}
    {{/is}}
{{/if}}

<main class="gh-main">
    {{> "components/post-list" feed="index" postFeedStyle=@custom.post_feed_style showTitle=true showSidebar=@custom.show_publication_info_sidebar}}
</main>